 },
 {
  "term": "Anti-aliasing filter",
  "definition": "A low-pass filter that removes sound above the limit before it is converted.",
  "section": "machines",
  "source_url": "https://www.izotope.com/en/learn/digital-audio-basics-sample-rate-and-bit-depth.html"
 },
 {
  "term": "Quantization noise",
